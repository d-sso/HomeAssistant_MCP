# Home Assistant connection (required)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token_here

# Scope filtering — comma-separated values, all optional
# When set, all tools automatically limit results to the matching entities
HA_SCOPE_AREAS=
HA_SCOPE_FLOORS=
HA_SCOPE_DOMAINS=
HA_SCOPE_LABELS=

# MQTT broker — used by bridge service
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=ha
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Bridge — comma-separated entity IDs to sync from prod to QA
BRIDGE_ENTITY_ALLOWLIST=
